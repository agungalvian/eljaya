# Environment Variables — CV. EL JAYA PONDASI
# Copy this file to .env and fill in your values

# PostgreSQL
POSTGRES_USER=ejp_user
POSTGRES_PASSWORD=ejp_secret
POSTGRES_DB=ejp_finance

# Backend
NODE_ENV=production
PORT=3001
DATABASE_URL=postgresql://ejp_user:ejp_secret@postgres:5432/ejp_finance
# Set CORS_ORIGIN to your frontend's production URL (e.g. https://eljaya.com or http://localhost:5151)
CORS_ORIGIN=http://localhost:5151
JWT_SECRET=ejp_super_secret_jwt_key_2026

# Frontend (Vite)
# Set VITE_API_URL to your backend's production API URL (e.g. https://eljaya.com or http://localhost:3010)
# If frontend and backend are served from the same domain/IP, you can leave this empty to fallback to window.location.origin
VITE_API_URL=http://localhost:3010
